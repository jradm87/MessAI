{
  "name": "@messai/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Many agents. One organized mess.",
  "author": "jradm87 <jradm87@gmail.com>",
  "homepage": "https://github.com/jradm87/MessAI",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview"
  },
  "build": {
    "appId": "app.messai.desktop",
    "productName": "MessAI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "npmRebuild": false,
    "publish": [{ "provider": "github", "owner": "jradm87", "repo": "MessAI" }],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "jradm87 <jradm87@gmail.com>",
      "synopsis": "Many agents. One organized mess."
    }
  },
  "dependencies": {
    "@messai/contracts": "0.0.1",
    "@messai/domain": "0.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "dompurify": "^3.2.6",
    "electron-updater": "^6.3.9",
    "jotai": "^2.14.0",
    "lucide-react": "^1.63.0",
    "marked": "^15.0.12",
    "mermaid": "^11.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "vite": "8.3.5"
  }
}
